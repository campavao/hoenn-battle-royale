+// Tell the software renderer about the band, once the core has installed it. Only at
+// loadGame: the band is the texture's size, which is made there.
+static void _brApplyViewport(void) {
+	struct GBAVideoSoftwareRenderer* sr = _brSoftwareRenderer();
+	if (!sr) {
+		return;
+	}
+	sr->brLeft = brBandLeft;
+	sr->brTop = brBandTop;
+	sr->brRight = brBandRight;
+	sr->brBottom = brBandBottom;
+	_brApplySpriteWindow(sr);
+	_brApplyOamTable(sr);
+	_brApplyWorld(sr);
+}
+
+// Hoenn BR (POK-329): the sprite window -- the 256 rows around the LCD where the ROM
+// keeps each sprite's 8-bit OAM y to one reading, `top` above the LCD and `bottom`
+// below (multiples of 8, summing to 96). A band row reads each sprite's y against it
+// and draws the sprite once, at its true rows; past it only 512-row BGs and the
+// weather's semi-transparent sprites are drawn, so a band taller than 256 rows shows
+// no row of a 256-row BG, and no sprite, twice. Anything that is not such a window
+// (0, 0 for one) clears it: then the band is the window when it is 256 rows, and there
+// is none otherwise -- every sprite and BG repeating every 256 rows, as before this.
+// Takes effect at once -- the band's rows are drawn at VBlank, on the core's thread, so
+// a call while it runs may land mid-band -- and at every loadGame after.
+EMSCRIPTEN_KEEPALIVE void brSetSpriteBand(int top, int bottom) {
+	struct GBAVideoSoftwareRenderer* sr;
+	top = _brClampBand(top, BR_BAND_MAX_ROWS);
+	bottom = _brClampBand(bottom, BR_BAND_MAX_ROWS);
+	if (top + bottom == BR_BAND_MAX_ROWS - GBA_VIDEO_VERTICAL_PIXELS) {
+		brSpriteTop = top;
+		brSpriteBottom = bottom;
+	} else {
+		brSpriteTop = -1;
+		brSpriteBottom = -1;
+	}
+	sr = _brSoftwareRenderer();
+	if (sr) {
+		_brApplySpriteWindow(sr);
+	}
+}
+
+// Hoenn BR: the ROM's OAM side table, at byte `offset` into work RAM (its EWRAM address
+// less 0x02000000), or -1 for none. 64 bytes, a nibble an OAM entry: bit 2 set when the
+// ROM wrote it, bits 0-1 the signed 256s its true top is past its 8-bit y (the ROM's
+// include/br/br_field.h). The ROM latches it when it copies its OAM buffer in, so the
+// band, drawn at VBlank before the next copy, reads the two together; with it every
+// marked sprite is drawn once at its true rows. Takes effect at once, and at every
+// loadGame after.
+EMSCRIPTEN_KEEPALIVE void brSetOamTable(int offset) {
+	struct GBAVideoSoftwareRenderer* sr;
+	brOamTable = offset >= 0 && offset + 64 <= GBA_SIZE_EWRAM ? offset : -1;
+	sr = _brSoftwareRenderer();
+	if (sr) {
+		_brApplyOamTable(sr);
+	}
+}
+
+// Hoenn BR (the whole window): the ROM's struct BrWorld (include/br/br_field.h), at byte
+// `offset` into work RAM, or -1 for none, and the GBA addresses of the build's
+// gBackupMapLayout, gMapHeader and gMain.callback2, CB2_Overworld's value (thumb bit set)
+// and gMapGroups (0 for none: then no joined map is read). With it, on the field, BG1..3 past the LCD are drawn from the ROM's map grid, so
+// a band of any size is the map. Takes effect at once, and at every loadGame after.
+EMSCRIPTEN_KEEPALIVE void brSetWorld(int offset, uint32_t grid, uint32_t header, uint32_t cb2, uint32_t overworld, uint32_t groups) {
+	struct GBAVideoSoftwareRenderer* sr;
+	brWorldTable = offset >= 0 && offset + 0x08 <= GBA_SIZE_EWRAM ? offset : -1;
+	brWorldGrid = grid;
+	brWorldHeader = header;
+	brWorldCb2 = cb2;
+	brWorldOverworld = overworld;
+	brWorldGroups = groups;
+	sr = _brSoftwareRenderer();
+	if (sr) {
+		_brApplyWorld(sr);
+	}
