+		} else {
+			fit->a[c] = (n * sxy[c] - sx[c] * sy[c]) / var;
+			fit->b[c] = (sy[c] - fit->a[c] * sx[c]) / n;
+		}
+	}
+}
+
+/* Slot `slot`'s BG palette: the renderer's, with secondary tileset `tileset`'s palettes in
+ * slots 6-12 as the fit makes them. */
+static const mColor* _brTilePalette(const struct GBAVideoSoftwareRenderer* renderer, int slot, uint32_t tileset, const struct BrPaletteFit* fit) {
+	const uint8_t* t = _brMem(renderer, tileset, 0x18);
+	const uint8_t* palettes = t ? _brMem(renderer, _brU32(t + BR_TILESET_PALETTES), BR_PALS_TOTAL * 32) : NULL;
+	mColor* out = _brTilePalettes[slot];
+	int i, c;
+	memcpy(out, renderer->normalPalette, 256 * sizeof(*out));
+	if (!palettes) {
+		return out;
+	}
+	for (i = BR_PALS_IN_PRIMARY * 16; i < BR_PALS_TOTAL * 16; ++i) {
+		uint16_t from = _brU16(palettes + 2 * i);
+		uint16_t to = 0;
+		for (c = 0; c < 3; ++c) {
+			double v = (((from >> (5 * c)) & 0x1F) * fit->a[c]) + fit->b[c] + 0.5;
+			int k = v < 0 ? 0 : v > 31 ? 31 : (int) v;
+			to |= k << (5 * c);
+		}
+		out[i] = mColorFrom555(to);
+	}
+	return out;
+}
+
+/* The maps joined to the one the ROM is on, from `header` (its struct MapHeader) out to
+ * BR_WORLD_DEPTH joins, placed on the backup grid the way fieldmap.c's Fill*Connection
+ * places the first ring of them. A map on another primary tileset, or whose tiles do not
+ * read, is left out: the grid and the border stand in for it, as before. */
+static void _brWorldMaps(const struct GBAVideoSoftwareRenderer* renderer, struct GBAVideoSoftwareBrWorld* world, const uint8_t* header, const uint8_t* layout) {
+	struct {
+		const uint8_t* header;
+		uint32_t layout;
+		int32_t x, y, width, height;
+		int depth;
+	} queue[BR_WORLD_MAPS + 1];
+	int head = 0, tail = 0;
+	uint32_t primary = _brU32(layout + BR_LAYOUT_PRIMARY);
+	uint32_t secondary = _brU32(layout + BR_LAYOUT_SECONDARY);
+	const uint8_t* primaryPalettes = NULL;
+	struct BrPaletteFit fit;
+	bool fitted = false;
+	world->nMaps = 0;
+	++_brTileFrame;
+	if (!renderer->brWorldGroups) {
+		return;
+	}
+	queue[tail].header = header;
+	queue[tail].layout = _brU32(header);
+	queue[tail].x = world->mapX;
+	queue[tail].y = world->mapY;
+	queue[tail].width = world->mapWidth;
+	queue[tail].height = world->mapHeight;
+	queue[tail].depth = 0;
+	++tail;
+	while (head < tail) {
+		int at = head++;
+		if (queue[at].depth >= BR_WORLD_DEPTH) {
+			continue;
+		}
+		const uint8_t* list = _brMem(renderer, _brU32(queue[at].header + BR_HEADER_CONNECTIONS), 8);
+		if (!list) {
+			continue;
+		}
+		int32_t count = (int32_t) _brU32(list);
+		const uint8_t* conns = count > 0 && count <= 16 ? _brMem(renderer, _brU32(list + 4), count * BR_CONNECTION_BYTES) : NULL;
+		int i;
+		for (i = 0; conns && i < count && tail <= BR_WORLD_MAPS; ++i) {
+			const uint8_t* conn = conns + i * BR_CONNECTION_BYTES;
+			int direction = conn[0];
+			int32_t offset = (int32_t) _brU32(conn + BR_CONNECTION_OFFSET);
+			const uint8_t* group = _brMem(renderer, renderer->brWorldGroups + 4 * conn[BR_CONNECTION_GROUP], 4);
+			const uint8_t* slot = group ? _brMem(renderer, _brU32(group) + 4 * conn[BR_CONNECTION_NUM], 4) : NULL;
+			const uint8_t* next = slot ? _brMem(renderer, _brU32(slot), 0x10) : NULL;
+			const uint8_t* nextLayout = next ? _brMem(renderer, _brU32(next), 0x18) : NULL;
+			if (!nextLayout || direction < BR_CONNECTION_SOUTH || direction > BR_CONNECTION_EAST) {
+				continue;
+			}
+			int32_t width = (int32_t) _brU32(nextLayout + BR_LAYOUT_WIDTH);
+			int32_t height = (int32_t) _brU32(nextLayout + BR_LAYOUT_HEIGHT);
+			if (width <= 0 || height <= 0 || width > 0x400 || height > 0x400) {
+				continue;
+			}
+			int32_t x = queue[at].x, y = queue[at].y;
+			switch (direction) {
+			case BR_CONNECTION_SOUTH:
+				x += offset;
+				y += queue[at].height;
+				break;
+			case BR_CONNECTION_NORTH:
+				x += offset;
+				y -= height;
+				break;
+			case BR_CONNECTION_WEST:
+				x -= width;
+				y += offset;
+				break;
+			case BR_CONNECTION_EAST:
+				x += queue[at].width;
+				y += offset;
+				break;
+			}
+			uint32_t nextLayoutAt = _brU32(next);
+			int k;
+			bool seen = false;
+			for (k = 0; k < tail; ++k) {
+				if (queue[k].layout == nextLayoutAt && queue[k].x == x && queue[k].y == y) {
+					seen = true;
+				}
+			}
+			if (seen || _brU32(nextLayout + BR_LAYOUT_PRIMARY) != primary) {
+				continue;
+			}
+			struct GBAVideoSoftwareBrWorldMap* map = &world->maps[world->nMaps];
+			uint32_t nextSecondary = _brU32(nextLayout + BR_LAYOUT_SECONDARY);
+			map->x = x;
+			map->y = y;
+			map->width = width;
+			map->height = height;
+			map->map = _brMem(renderer, _brU32(nextLayout + BR_LAYOUT_MAP), (uint32_t) (width * height * 2));
+			map->tiles = NULL;
+			map->palette = NULL;
+			if (nextSecondary == secondary) {
+				map->metatiles = world->metatiles[1];
+				map->attributes = world->attributes[1];
+			} else {
+				int cache;
+				map->metatiles = _brTileset(renderer, nextSecondary, BR_TILESET_METATILES, (BR_METATILES_TOTAL - BR_METATILES_IN_PRIMARY) * BR_METATILE_BYTES);
+				map->attributes = _brTileset(renderer, nextSecondary, BR_TILESET_ATTRIBUTES, (BR_METATILES_TOTAL - BR_METATILES_IN_PRIMARY) * 2);
+				cache = map->metatiles && map->attributes ? _brTileSlot(renderer, nextSecondary) : -1;
+				if (cache < 0) {
+					continue;
+				}
+				_brAnimate(renderer, cache, nextSecondary);
+				if (!fitted) {
+					const uint8_t* p = _brMem(renderer, primary, 0x18);
+					primaryPalettes = p ? _brMem(renderer, _brU32(p + BR_TILESET_PALETTES), BR_PALS_IN_PRIMARY * 32) : NULL;
+					if (!primaryPalettes) {
+						continue;
+					}
+					_brFitPalettes(renderer, primaryPalettes, &fit);
+					fitted = true;
+				}
+				map->tiles = _brTileCache[cache].tiles;
+				map->palette = _brTilePalette(renderer, cache, nextSecondary, &fit);
+			}
+			if (!map->map || !map->metatiles || !map->attributes) {
+				continue;
+			}
+			++world->nMaps;
+			queue[tail].header = next;
+			queue[tail].layout = nextLayoutAt;
+			queue[tail].x = x;
+			queue[tail].y = y;
+			queue[tail].width = width;
+			queue[tail].height = height;
+			queue[tail].depth = queue[at].depth + 1;
+			++tail;
+		}
+	}
+}
+
+/* The frame's grid and BG tiles as they were at its first row. Stepping over a join, the
+ * ROM loads the next map in the middle of a frame -- the grid rewritten, and the tiles too
+ * when the tilesets differ -- while the LCD and gBrWorld are still the old map's until the
+ * VBlank: read live, the band past the LCD draws the new map at the old one's place. */
+static uint8_t* _brGridCopy;
+static uint32_t _brGridCopySize;
+static uint16_t _brVramCopy[0x8000];
+
+/* The frame's world, when the ROM is on the field and every pointer reads. */
+bool GBAVideoSoftwareRendererBrWorld(const struct GBAVideoSoftwareRenderer* renderer, struct GBAVideoSoftwareBrWorld* world) {
+	if (!renderer->brWorld || !renderer->brWram) {
+		return false;
+	}
+	const uint8_t* w = renderer->brWorld;
+	const uint8_t* cb2 = _brMem(renderer, renderer->brWorldCb2, 4);
+	if (!cb2 || _brU32(cb2) != renderer->brWorldOverworld || !_brU32(cb2)) {
+		return false;
+	}
+	const uint8_t* header = _brMem(renderer, renderer->brWorldHeader, 4);
+	const uint8_t* layout = header ? _brMem(renderer, _brU32(header), 0x18) : NULL;
+	const uint8_t* grid = _brMem(renderer, renderer->brWorldGrid, 12);
+	if (!layout || !grid) {
+		return false;
+	}
+	world->width = (int32_t) _brU32(grid);
+	world->height = (int32_t) _brU32(grid + 4);
+	if (world->width <= 0 || world->height <= 0 || world->width > 0x400 || world->height > 0x400) {
+		return false;
+	}
+	world->map = _brMem(renderer, _brU32(grid + 8), (uint32_t) (world->width * world->height * 2));
+	if (world->map) {
+		uint32_t size = (uint32_t) (world->width * world->height * 2);
+		if (size > _brGridCopySize) {
+			uint8_t* grown = realloc(_brGridCopy, size);
+			if (!grown) {
+				return false;
+			}
+			_brGridCopy = grown;
+			_brGridCopySize = size;
+		}
+		memcpy(_brGridCopy, world->map, size);
+		world->map = _brGridCopy;
+	}
+	memcpy(_brVramCopy, renderer->d.vram, sizeof(_brVramCopy));
+	world->vram = _brVramCopy;
+	world->border = _brMem(renderer, _brU32(layout + BR_LAYOUT_BORDER), 8);
+	uint32_t primary = _brU32(layout + BR_LAYOUT_PRIMARY);
+	uint32_t secondary = _brU32(layout + BR_LAYOUT_SECONDARY);
+	world->metatiles[0] = _brTileset(renderer, primary, BR_TILESET_METATILES, BR_METATILES_IN_PRIMARY * BR_METATILE_BYTES);
+	world->attributes[0] = _brTileset(renderer, primary, BR_TILESET_ATTRIBUTES, BR_METATILES_IN_PRIMARY * 2);
+	world->metatiles[1] = _brTileset(renderer, secondary, BR_TILESET_METATILES, (BR_METATILES_TOTAL - BR_METATILES_IN_PRIMARY) * BR_METATILE_BYTES);
+	world->attributes[1] = _brTileset(renderer, secondary, BR_TILESET_ATTRIBUTES, (BR_METATILES_TOTAL - BR_METATILES_IN_PRIMARY) * 2);
+	if (!world->map || !world->border || !world->metatiles[0] || !world->attributes[0] || !world->metatiles[1] || !world->attributes[1]) {
+		return false;
+	}
+	world->hofs = _brU16(w + BR_WORLD_HOFS);
+	world->vofs = _brU16(w + BR_WORLD_VOFS);
+	world->lcdX = (int16_t) _brU16(w + BR_WORLD_LCD_X);
+	world->lcdY = (int16_t) _brU16(w + BR_WORLD_LCD_Y);
+	world->mapX = BR_MAP_OFFSET;
+	world->mapY = BR_MAP_OFFSET;
+	world->mapWidth = (int32_t) _brU32(layout + BR_LAYOUT_WIDTH);
+	world->mapHeight = (int32_t) _brU32(layout + BR_LAYOUT_HEIGHT);
+	world->layout = _brU32(header);
+	{
+		/* The fit for the page's people: without the primary's palettes, none. */
+		const uint8_t* p = _brMem(renderer, primary, 0x18);
+		const uint8_t* palettes = p ? _brMem(renderer, _brU32(p + BR_TILESET_PALETTES), BR_PALS_IN_PRIMARY * 32) : NULL;
+		struct BrPaletteFit fit;
+		int c;
+		if (palettes) {
+			_brFitPalettes(renderer, palettes, &fit);
+		}
+		for (c = 0; c < 3; ++c) {
+			world->fitA[c] = palettes ? (float) fit.a[c] : 1.0f;
+			world->fitB[c] = palettes ? (float) fit.b[c] : 0.0f;
+		}
+	}
+	world->nMaps = 0;
+	if (world->mapWidth > 0 && world->mapHeight > 0) {
+		const uint8_t* fullHeader = _brMem(renderer, renderer->brWorldHeader, 0x10);
+		if (fullHeader) {
+			_brWorldMaps(renderer, world, fullHeader, layout);
+		}
+	}
+	return true;
+}
+
+/* A 9-bit scroll's distance, in [-256, 256). */
+static int _brScrollDistance(int v) {
+	return ((v & 0x1FF) ^ 0x100) - 0x100;
+}
+
+/* The tilemap entry BG `bg` (1..3) would hold at grid pixel (px, py): what DrawMetatile
+ * (src/field_camera.c) writes for the metatile MapGridGetMetatileIdAt reads there. */
+static uint16_t _brWorldEntry(const struct GBAVideoSoftwareBrWorld* world, int bg, int px, int py, const uint8_t** cellTiles, const mColor** cellPalette) {
+	int cx = px >> 4;
+	int cy = py >> 4;
+	unsigned id = BR_MAPGRID_METATILE_ID_MASK;
+	const uint8_t* metatiles = world->metatiles[1];
+	const uint8_t* attributes = world->attributes[1];
+	bool joined = false;
+	*cellTiles = NULL;
+	*cellPalette = NULL;
+	/* Off the map itself, a joined map's own cells, from the cartridge: the grid holds only
+	 * MAP_OFFSET of them, and the border past that. On it, the grid, which the ROM edits. */
+	if (cx < world->mapX || cx >= world->mapX + world->mapWidth || cy < world->mapY || cy >= world->mapY + world->mapHeight) {
+		int i;
+		for (i = 0; i < world->nMaps; ++i) {
+			const struct GBAVideoSoftwareBrWorldMap* map = &world->maps[i];
+			if (cx >= map->x && cx < map->x + map->width && cy >= map->y && cy < map->y + map->height) {
+				id = _brU16(map->map + 2 * ((cx - map->x) + map->width * (cy - map->y)));
+				metatiles = map->metatiles;
+				attributes = map->attributes;
+				*cellTiles = map->tiles;
+				*cellPalette = map->palette;
+				joined = true;
+				break;
+			}
+		}
+	}
+	if (!joined && cx >= 0 && cx < world->width && cy >= 0 && cy < world->height) {
+		id = _brU16(world->map + 2 * (cx + world->width * cy));
+	}
+	if ((id & BR_MAPGRID_METATILE_ID_MASK) == BR_MAPGRID_METATILE_ID_MASK || (!joined && (cx < 0 || cx >= world->width || cy < 0 || cy >= world->height))) {
+		id = _brU16(world->border + 2 * (((cx + 1) & 1) + (((cy + 1) & 1) << 1)));
+		metatiles = world->metatiles[1];
+		attributes = world->attributes[1];
+		*cellTiles = NULL;
+		*cellPalette = NULL;
+	}
+	id &= BR_MAPGRID_METATILE_ID_MASK;
+	int set = id >= BR_METATILES_IN_PRIMARY;
+	unsigned local = id - (set ? BR_METATILES_IN_PRIMARY : 0);
+	const uint8_t* attribute = (set ? attributes : world->attributes[0]) + 2 * local;
+	const uint8_t* tiles = (set ? metatiles : world->metatiles[0]) + BR_METATILE_BYTES * local;
+	int layer = _brU16(attribute) >> 12;
+	int q = ((px >> 3) & 1) | (((py >> 3) & 1) << 1);
+	switch (layer) {
+	case 0: /* METATILE_LAYER_TYPE_NORMAL */
+		return bg == 3 ? 0x3014 : bg == 2 ? _brU16(tiles + 2 * q) : _brU16(tiles + 2 * (4 + q));
+	case 1: /* METATILE_LAYER_TYPE_COVERED */
+		return bg == 3 ? _brU16(tiles + 2 * q) : bg == 2 ? _brU16(tiles + 2 * (4 + q)) : 0;
+	case 2: /* METATILE_LAYER_TYPE_SPLIT */
+		return bg == 3 ? _brU16(tiles + 2 * q) : bg == 2 ? 0 : _brU16(tiles + 2 * (4 + q));
+	default:
+		return 0;
+	}
+}
+
+#define DRAW_BACKGROUND_WORLD_16(BLEND, OBJWIN) \
+	for (outX = renderer->start; outX < renderer->end;) { \
+		int px = originX + outX; \
+		int mod8 = px & 7; \
+		int n = 8 - mod8; \
+		if (outX + n > renderer->end) { \
+			n = renderer->end - outX; \
+		} \
+		mapData = _brWorldEntry(world, bg, px, py, &cellTiles, &cellPalette); \
+		localY = py & 7; \
+		if (GBA_TEXT_MAP_VFLIP(mapData)) { \
+			localY = 7 - localY; \
+		} \
+		paletteData = GBA_TEXT_MAP_PALETTE(mapData) << 4; \
+		palette = cellPalette && paletteData >= BR_PALS_IN_PRIMARY * 16 ? (mColor*) cellPalette : basePalette; \
+		charBase = (background->charBase + (GBA_TEXT_MAP_TILE(mapData) << 5)) + (localY << 2); \
+		if (cellTiles && GBA_TEXT_MAP_TILE(mapData) >= BR_TILES_IN_PRIMARY) { \
+			const uint8_t* src = cellTiles + ((GBA_TEXT_MAP_TILE(mapData) - BR_TILES_IN_PRIMARY) << 5) + (localY << 2); \
+			tileData = _brU32(src); \
+			if (GBA_TEXT_MAP_HFLIP(mapData)) { \
+				tileData = (tileData >> 24) | ((tileData >> 8) & 0xFF00) | ((tileData << 8) & 0xFF0000) | (tileData << 24); \
+				tileData = ((tileData & 0xF0F0F0F0) >> 4) | ((tileData & 0x0F0F0F0F) << 4); \
+			} \
+			charBase = 0; \
+		} else if (LIKELY(charBase < 0x10000)) { \
+			if (!GBA_TEXT_MAP_HFLIP(mapData)) { \
+				LOAD_32(tileData, charBase, vram); \
+			} else { \
+				LOAD_32BE(tileData, charBase, vram); \
+				tileData = ((tileData & 0xF0F0F0F0) >> 4) | ((tileData & 0x0F0F0F0F) << 4); \
+			} \
+		} \
+		if (LIKELY(charBase < 0x10000)) { \
+			tileData >>= 4 * mod8; \
+			uint32_t* pixel = &renderer->row[outX]; \
+			int k; \
+			for (k = 0; k < n; ++k, ++pixel) { \
+				BACKGROUND_DRAW_PIXEL_16(BLEND, OBJWIN, 0); \
+			} \
+		} \
+		outX += n; \
+	}
+
+/* Hoenn BR (the whole window): text BG `background` (BG1..3, 16 colours) on this row's
+ * window, from the map grid instead of the BG's tilemap. Row index i is LCD column
+ * i - brLeft; its grid pixel is the world's lcdX moved by how far the scroll this row is
+ * drawn with has come from the one the world was written with. */
+void GBAVideoSoftwareRendererDrawBackgroundWorld(struct GBAVideoSoftwareRenderer* renderer, struct GBAVideoSoftwareBackground* background, int y, const struct GBAVideoSoftwareBrWorld* world) {
+	int bg = background->index;
+	int originX = world->lcdX + _brScrollDistance(background->x - background->offsetX - world->hofs) - renderer->brLeft;
+	int py = world->lcdY + _brScrollDistance(background->y - background->offsetY - world->vofs) + y;
+	uint16_t mapData;
+	int localY;
+	uint32_t flags = background->flags;
+	uint32_t objwinFlags = background->objwinFlags;
+	bool variant = background->variant;
+	uint32_t charBase;
+	mColor* palette = renderer->normalPalette;
+	if (renderer->d.highlightAmount && background->highlight) {
+		palette = renderer->highlightPalette;
+	}
+	if (variant) {
+		palette = renderer->variantPalette;
+		if (renderer->d.highlightAmount && background->highlight) {
+			palette = renderer->highlightVariantPalette;
+		}
+	}
+	PREPARE_OBJWIN;
+	int outX;
+	uint32_t tileData;
+	uint32_t current;
+	int pixelData;
+	int paletteData;
+	uint16_t* vram = world->vram;
+	mColor* basePalette = palette;
+	const uint8_t* cellTiles;
+	const mColor* cellPalette;
+	UNUSED(objwinFlags);
+	if (!objwinSlowPath) {
+		if (!(flags & FLAG_TARGET_2)) {
+			DRAW_BACKGROUND_WORLD_16(NoBlend, NO_OBJWIN);
+		} else {
+			DRAW_BACKGROUND_WORLD_16(Blend, NO_OBJWIN);
+		}
+	} else {
+		if (!(flags & FLAG_TARGET_2)) {
+			DRAW_BACKGROUND_WORLD_16(NoBlend, OBJWIN);
+		} else {
+			DRAW_BACKGROUND_WORLD_16(Blend, OBJWIN);
+		}
+	}
+}
+
+/* Hoenn BR (the whole window, HBR-27): the page's people on picture row `y` (LCD rows
+ * 0-159, the band's either side), into the sprite layer the ROM's own objects went into,
+ * so the BGs cover them by priority as they cover the ROM's: a roof (BG1) over a person
+ * at priority 2 (POK-443). `buf` is the frame's copy of brSetPeople's buffer: a u32 layout and a u32 count, then a
+ * 16-byte entry each -- s16 x, s16 y (grid pixels, MAP_OFFSET in, of the sprite's
+ * top-left), u8 width, u8 height, u8 flags (bit 0 h-flip, bits 1-2 priority), a pad
+ * byte, the u32 byte offset of its pixels in the buffer and 4 more pad bytes -- each
+ * pixel a u16, BGR555 with bit 15 set where it is drawn. The first entry is in front,
+ * and the ROM's own objects in front of them all. Placed on the frame's own anchor, and
+ * only on the map they were placed for: a map just loaded has none until the page's
+ * next frame. Returns the priorities drawn into, a bit each. */
+#define BR_PEOPLE_HEADER 8
+#define BR_PEOPLE_ENTRY 16
+int GBAVideoSoftwareRendererDrawPeople(struct GBAVideoSoftwareRenderer* renderer, int y, const struct GBAVideoSoftwareBrWorld* world, const uint8_t* buf, uint32_t bytes) {
+	uint32_t count, i;
+	int width = BR_ROW_WIDTH(renderer);
+	int drawn = 0;
+	if (!buf || bytes < BR_PEOPLE_HEADER || _brU32(buf) != world->layout) {
+		return 0;
+	}
+	count = _brU32(buf + 4);
+	if (count > (bytes - BR_PEOPLE_HEADER) / BR_PEOPLE_ENTRY) {
+		count = (bytes - BR_PEOPLE_HEADER) / BR_PEOPLE_ENTRY;
+	}
+	for (i = 0; i < count; ++i) {
+		const uint8_t* e = buf + BR_PEOPLE_HEADER + i * BR_PEOPLE_ENTRY;
+		int w = e[4];
+		int h = e[5];
+		int flip = e[6] & 1;
+		unsigned priority = (e[6] >> 1) & 3;
+		uint32_t at = _brU32(e + 8);
+		int row = world->lcdY + y - (int16_t) _brU16(e + 2);
+		int left = (int16_t) _brU16(e) - world->lcdX + renderer->brLeft;
+		uint32_t flags = priority << OFFSET_PRIORITY;
