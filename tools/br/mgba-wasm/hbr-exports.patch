+// Hoenn Battle Royale: byte offsets into the wasm heap of the GBA's work RAM, so the
+// page can read/write EWRAM/IWRAM through Module.HEAPU8 with no copy. 0 when no GBA core.
+EMSCRIPTEN_KEEPALIVE uint32_t brWramPtr() {
+	if (!renderer->core || renderer->core->platform(renderer->core) != mPLATFORM_GBA)
+		return 0;
+	struct GBA* gba = (struct GBA*) renderer->core->board;
+	return (uint32_t) (uintptr_t) gba->memory.wram;
+}
+
+EMSCRIPTEN_KEEPALIVE uint32_t brIwramPtr() {
+	if (!renderer->core || renderer->core->platform(renderer->core) != mPLATFORM_GBA)
+		return 0;
+	struct GBA* gba = (struct GBA*) renderer->core->board;
+	return (uint32_t) (uintptr_t) gba->memory.iwram;
+}
