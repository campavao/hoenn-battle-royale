+	int oldest = -1;
+	++_brTileClock;
+	for (slot = 0; slot < BR_WORLD_TILE_SLOTS; ++slot) {
+		if (_brTileCache[slot].source == tiles) {
+			if (_brTileCache[slot].bad) {
+				return -1;
+			}
+			_brTileCache[slot].used = _brTileClock;
+			_brTileCache[slot].frame = _brTileFrame;
+			return slot;
+		}
+		if (_brTileCache[slot].frame != _brTileFrame && (oldest < 0 || _brTileCache[slot].used < _brTileCache[oldest].used)) {
+			oldest = slot;
+		}
+	}
+	if (oldest < 0) {
+		return -1;
+	}
+	slot = oldest;
+	_brTileCache[slot].source = tiles;
+	_brTileCache[slot].used = _brTileClock;
+	_brTileCache[slot].frame = _brTileFrame;
+	_brTileCache[slot].animated = 0;
+	_brTileCache[slot].bad = false;
