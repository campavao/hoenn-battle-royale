+// Hoenn BR (HBR-27): the back buffer, at least `bytes` long, for the page to write its
+// people into; 0 if it cannot be had. Growing it moves it.
+EMSCRIPTEN_KEEPALIVE uint32_t brPeopleBuffer(int bytes) {
+	if (bytes < 0) {
+		return 0;
+	}
+	if ((uint32_t) bytes > brPeopleCap) {
+		uint8_t* grown = realloc(brPeople, (size_t) bytes);
+		if (!grown) {
+			return 0;
+		}
+		brPeople = grown;
+		brPeopleCap = (uint32_t) bytes;
+	}
+	return (uint32_t) (uintptr_t) brPeople;
+}
+
+// Hoenn BR (HBR-27): publish the back buffer's first `bytes` as the people to draw from the
+// next frame on (software-mode0.c GBAVideoSoftwareRendererDrawPeople has the layout); 0
+// for nobody.
+EMSCRIPTEN_KEEPALIVE void brSetPeople(int bytes) {
+	struct GBAVideoSoftwareRenderer* sr;
+	uint32_t n = bytes > 0 && (uint32_t) bytes <= brPeopleCap ? (uint32_t) bytes : 0;
+	MutexLock(_brPeopleLock());
+	if (n > brPeoplePubCap) {
+		uint8_t* grown = realloc(brPeoplePub, n);
+		if (grown) {
+			brPeoplePub = grown;
+			brPeoplePubCap = n;
+		} else {
+			n = 0;
+		}
+	}
+	if (n) {
+		memcpy(brPeoplePub, brPeople, n);
+	}
+	brPeoplePubBytes = n;
+	sr = _brSoftwareRenderer();
+	if (sr) {
+		sr->brPeopleLock = &brPeopleLock;
+		sr->brPeople = n ? brPeoplePub : NULL;
+		sr->brPeopleBytes = n;
+	}
+	MutexUnlock(&brPeopleLock);
+}
+
+// Hoenn BR (HBR-27): the back buffer, at least `bytes` long, for the page to write the
+// tileset animation table into (software-mode0.c GBAVideoSoftwareRendererBrAnims has the
+// layout); 0 if it cannot be had. Growing it moves it.
+EMSCRIPTEN_KEEPALIVE uint32_t brTileAnimBuffer(int bytes) {
+	if (bytes < 0) {
+		return 0;
+	}
+	if ((uint32_t) bytes > brAnimsCap) {
+		uint8_t* grown = realloc(brAnims, (size_t) bytes);
+		if (!grown) {
+			return 0;
+		}
+		brAnims = grown;
+		brAnimsCap = (uint32_t) bytes;
+	}
+	return (uint32_t) (uintptr_t) brAnims;
+}
+
+// Hoenn BR (HBR-27): publish the back buffer's first `bytes` as the table, from the next
+// frame on; 0 for none. The published copy is made anew: the core reads it only under
+// the lock, and copies it then.
+EMSCRIPTEN_KEEPALIVE void brSetTileAnims(int bytes) {
+	struct GBAVideoSoftwareRenderer* sr;
+	uint32_t n = bytes > 0 && (uint32_t) bytes <= brAnimsCap ? (uint32_t) bytes : 0;
+	uint8_t* copy = n ? malloc(n) : NULL;
+	if (copy) {
+		memcpy(copy, brAnims, n);
+	} else {
+		n = 0;
+	}
+	MutexLock(_brPeopleLock());
+	free(brAnimsPub);
+	brAnimsPub = copy;
+	brAnimsPubBytes = n;
+	sr = _brSoftwareRenderer();
+	if (sr) {
+		sr->brPeopleLock = &brPeopleLock;
+		sr->brAnims = copy;
+		sr->brAnimsBytes = n;
+	}
+	MutexUnlock(&brPeopleLock);
+}
+
+// Hoenn BR (HBR-27): the joined maps the last frame drew past the map the ROM is on, as
+// int32s: [drawn, n, then each map's x, y, width and height in metatiles from that map];
+// drawn is 0 off the field, where the core draws no world. The page draws its stills of
+// the maps only where the core did not.
+static int32_t brDrawnOut[2 + 4 * 64];
+
+EMSCRIPTEN_KEEPALIVE uint32_t brWorldDrawn(void) {
+	brDrawnOut[0] = 0;
+	brDrawnOut[1] = 0;
+	MutexLock(_brPeopleLock());
+	GBAVideoSoftwareRendererBrDrawn(brDrawnOut, sizeof(brDrawnOut) / sizeof(brDrawnOut[0]));
+	MutexUnlock(&brPeopleLock);
+	return (uint32_t) (uintptr_t) brDrawnOut;
+}
+
+// Hoenn BR (POK-329): the sprite window the loaded core draws with, as `top << 16 |
+// bottom`, or -1 for none (or no core): what the page's tests read back.
+EMSCRIPTEN_KEEPALIVE int brSpriteWindow(void) {
+	struct GBAVideoSoftwareRenderer* sr = _brSoftwareRenderer();
+	if (!sr || sr->brSpriteBottom < 0) {
+		return -1;
+	}
+	return (sr->brSpriteTop << 16) | sr->brSpriteBottom;
+}
