+/* The BIOS's LZ77 (type 0x10), as LZ77UnCompVram reads it, into at most `size` bytes. */
+static bool _brLz77(const struct GBAVideoSoftwareRenderer* renderer, uint32_t address, uint8_t* out, uint32_t size) {
+	const uint8_t* header = _brMem(renderer, address, 4);
+	if (!header || header[0] != 0x10) {
+		return false;
+	}
+	uint32_t length = _brU32(header) >> 8;
+	if (length > size) {
+		length = size;
+	}
+	uint32_t in = (address & 0x1FFFFFF) + 4;
+	uint32_t end = renderer->brRomSize;
+	const uint8_t* rom = renderer->brRom;
+	uint32_t written = 0;
+	while (written < length) {
+		if (in >= end) {
+			return false;
+		}
+		uint8_t flags = rom[in++];
+		int bit;
+		for (bit = 0; bit < 8 && written < length; ++bit, flags <<= 1) {
+			if (!(flags & 0x80)) {
+				if (in >= end) {
+					return false;
+				}
+				out[written++] = rom[in++];
+				continue;
+			}
+			if (in + 1 >= end) {
+				return false;
+			}
+			uint32_t count = (rom[in] >> 4) + 3;
+			uint32_t back = (((rom[in] & 0xF) << 8) | rom[in + 1]) + 1;
+			in += 2;
+			if (back > written) {
+				return false;
+			}
+			while (count-- && written < length) {
+				out[written] = out[written - back];
+				++written;
+			}
+		}
+	}
+	return true;
