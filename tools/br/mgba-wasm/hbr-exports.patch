+/* The cache slot holding secondary tileset `tileset`'s tiles, decoding them into the least
+ * recently used one if none does; -1 if they do not read. */
+static int _brTileSlot(const struct GBAVideoSoftwareRenderer* renderer, uint32_t tileset) {
+	const uint8_t* t = _brMem(renderer, tileset, 0x18);
+	if (!t) {
+		return -1;
+	}
+	uint32_t tiles = _brU32(t + BR_TILESET_TILES);
