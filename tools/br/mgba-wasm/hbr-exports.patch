+	count = _brU32(_brAnims + 4);
+	if (count > (_brAnimsBytes - BR_ANIMS_HEADER) / BR_ANIMS_ENTRY) {
+		count = (_brAnimsBytes - BR_ANIMS_HEADER) / BR_ANIMS_ENTRY;
+	}
+	for (i = 0; i < count; ++i) {
+		const uint8_t* e = _brAnims + BR_ANIMS_HEADER + i * BR_ANIMS_ENTRY;
+		uint32_t frames = _brU32(e + 4);
+		unsigned dest = _brU16(e + 12);
+		unsigned tiles = _brU16(e + 14);
+		unsigned n = e[16];
+		unsigned div = e[19];
+		int at;
+		uint16_t d;
+		const uint8_t* p;
+		const uint8_t* src;
+		if (_brU32(e) != tileset || !div || dest + tiles > BR_TILES_IN_PRIMARY) {
+			continue;
+		}
+		at = t - (t + 256 - e[20]) % div;
+		if (at < 0) {
+			at += 256;
+		}
+		d = (uint16_t) (at / div - (int8_t) e[21]);
+		if (_brU32(e + 8) && d >= e[18]) {
+			frames = _brU32(e + 8);
+			n = e[17];
+		}
+		if (!n) {
