+/* Hoenn BR (the whole window). The ROM's work RAM (both) and cartridge, read the way the bus
+ * would: NULL for an address outside them or a read that would run off their end. */
+#define BR_EWRAM_SIZE 0x40000
+#define BR_IWRAM_SIZE 0x8000
+
+static const uint8_t* _brMem(const struct GBAVideoSoftwareRenderer* renderer, uint32_t address, uint32_t size) {
+	uint32_t region = address >> 24;
+	if (region == 0x02) {
+		uint32_t offset = address & 0xFFFFFF;
+		return offset + size <= BR_EWRAM_SIZE ? renderer->brWram + offset : NULL;
+	}
+	if (region == 0x03) {
+		uint32_t offset = address & 0xFFFFFF;
+		return renderer->brIwram && offset + size <= BR_IWRAM_SIZE ? renderer->brIwram + offset : NULL;
+	}
+	if (region >= 0x08 && region <= 0x0D) {
+		uint32_t offset = address & 0x1FFFFFF;
+		return renderer->brRom && offset + size <= renderer->brRomSize ? renderer->brRom + offset : NULL;
+	}
+	return NULL;
